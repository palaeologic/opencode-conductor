{
  "projectKey": "example-project",
  "descriptorSchemaVersion": 3,
  "projectRootPath": "~/projects/example-project",
  "opencodeProjectRootPath": "~/.config/opencode/projects/example-project",
  "projectAgentsPath": "~/projects/example-project/AGENTS.md",
  "baselineBranchForMaterialChanges": "main",
  "handoffModeDefault": "tracked",
  "subtaskModels": {},
  "reviewIgnoredPathGlobs": ["**/generated/**", "**/*.snap"],
  "branchSyncStaleAfterMinutes": 90,
  "areas": {
    "frontend": {
      "pathPrefix": "frontend",
      "areaAgentsPath": "~/projects/example-project/frontend/AGENTS.md",
      "commandsRoot": "frontend"
    },
    "backend": {
      "pathPrefix": "backend",
      "areaAgentsPath": "~/projects/example-project/backend/AGENTS.md",
      "commandsRoot": "backend"
    },
    "cli": {
      "pathPrefix": "cli",
      "areaAgentsPath": "~/projects/example-project/cli/AGENTS.md",
      "commandsRoot": "cli"
    }
  },
  "pseudoPackageDetection": [
    {
      "area": "frontend",
      "kind": "pathAndAlias",
      "pathPattern": "frontend/src/{packageName}/**/*",
      "aliases": ["@org/{packageName}", "@platform/{packageName}"]
    }
  ],
  "trackedKnowledgeTargets": {
    "sharedPackageKnowledge": {
      "forms": "~/.config/opencode/projects/example-project/frontend/packages/forms/KNOWLEDGE.md",
      "reports": "~/.config/opencode/projects/example-project/frontend/packages/reports/KNOWLEDGE.md",
      "table": "~/.config/opencode/projects/example-project/frontend/packages/table/KNOWLEDGE.md"
    },
    "trackedAreas": ["frontend", "backend", "cli"]
  },
  "branchHandoff": {
    "contextDirTemplate": "~/.config/opencode/projects/{projectKey}/branches/{branchName}",
    "checkpointField": "reviewed_through",
    "templatesDir": "~/.config/opencode/projects/{projectKey}/_templates/mr",
    "helperManifestFilename": "HELPERS.json",
    "helpers": {
      "log": {
        "filename": "LOG.md",
        "templateFilename": "LOG.md",
        "role": "log",
        "bootstrap": "ask",
        "description": "Progress log for checkpoints and handoffs."
      },
      "review": {
        "filename": "REVIEW.md",
        "role": "review",
        "bootstrap": "never",
        "description": "Structured review notes and triage."
      },
      "mergeRequest": {
        "filename": "MERGE_REQUEST.md",
        "templateFilename": "MERGE_REQUEST.md",
        "role": "merge_request",
        "bootstrap": "ask",
        "branchPlaceholder": "<branch-name>",
        "description": "Local change-request context."
      },
      "phasePlan": {
        "filename": "PHASES.md",
        "templateFilename": "PHASES.md",
        "role": "phases",
        "bootstrap": "ask",
        "description": "Optional staged phase plan."
      }
    }
  },
  "refreshToolHeuristics": {
    "changedFilesAreaPrefixes": ["frontend/", "backend/", "cli/"],
    "highSignalChangedSubstrings": [
      "frontend/package.json",
      "frontend/eslint.config",
      "frontend/tsconfig.json",
      "frontend/src/app.tsx",
      "frontend/src/providers/Providers.tsx",
      "frontend/src/router.tsx"
    ]
  }
}
