{
  "projectKey": "my-project",
  "descriptorSchemaVersion": 3,
  "projectRootPath": "~/projects/my-project",
  "opencodeProjectRootPath": "~/.config/opencode/projects/my-project",
  "projectAgentsPath": "~/projects/my-project/AGENTS.md",
  "baselineBranchForMaterialChanges": "main",
  "handoffModeDefault": "tracked",
  "conductorStateLocation": "global",
  "localStateDirname": ".opencode-conductor",
  "reviewIgnoredPathGlobs": [],
  "branchSyncStaleAfterMinutes": 60,
  "subtaskModels": {},
  "areas": {
    "frontend": {
      "pathPrefix": "frontend",
      "areaAgentsPath": "~/projects/my-project/frontend/AGENTS.md",
      "commandsRoot": "frontend"
    },
    "backend": {
      "pathPrefix": "backend",
      "areaAgentsPath": "~/projects/my-project/backend/AGENTS.md",
      "commandsRoot": "backend"
    },
    "cli": {
      "pathPrefix": "cli",
      "areaAgentsPath": "~/projects/my-project/cli/AGENTS.md",
      "commandsRoot": "cli"
    }
  },
  "pseudoPackageDetection": [
    {
      "area": "frontend",
      "kind": "pathAndAlias",
      "pathPattern": "frontend/src/{packageName}/**/*",
      "aliases": [
        "@org/{packageName}"
      ]
    },
    {
      "area": "backend",
      "kind": "pathPrefix",
      "pathPattern": "backend/{packageName}/**/*",
      "namePrefixes": [
        "core_",
        "feature_"
      ],
      "namedExtras": [
        "shared_core"
      ]
    }
  ],
  "trackedKnowledgeTargets": {
    "sharedPackageKnowledge": {},
    "trackedAreas": [
      "frontend",
      "backend",
      "cli"
    ]
  },
  "branchHandoff": {
    "contextDirTemplate": "~/.config/opencode/projects/{projectKey}/branches/{branchName}",
    "checkpointField": "reviewed_through",
    "templatesDir": "~/.config/opencode/projects/{projectKey}/_templates/mr",
    "helperManifestFilename": "HELPERS.json",
    "helpers": {
      "log": {
        "filename": "LOG.md",
        "templateFilename": "LOG.md",
        "role": "log",
        "bootstrap": "ask",
        "description": "Progress log for checkpoints and handoffs between sessions."
      },
      "review": {
        "filename": "REVIEW.md",
        "role": "review",
        "bootstrap": "never",
        "description": "Review notes for structured findings, triage, and suggested verification."
      },
      "mergeRequest": {
        "filename": "MERGE_REQUEST.md",
        "templateFilename": "MERGE_REQUEST.md",
        "role": "merge_request",
        "bootstrap": "ask",
        "branchPlaceholder": "<branch-name>",
        "description": "Local change-request context with goal, scope, acceptance criteria, and reviewer notes."
      },
      "phasePlan": {
        "filename": "PHASES.md",
        "templateFilename": "PHASES.md",
        "role": "phases",
        "bootstrap": "ask",
        "description": "Phase plan for larger branches with staged deliverables and exit criteria."
      },
      "shortMergeRequest": {
        "filename": "MR.md",
        "templateFilename": "MR.md",
        "role": "merge_request",
        "bootstrap": "never",
        "branchPlaceholder": "<branch-name>",
        "description": "Optional alternate change-request context file."
      }
    }
  },
  "refreshToolHeuristics": {
    "changedFilesAreaPrefixes": [
      "frontend/",
      "backend/",
      "cli/"
    ],
    "highSignalChangedSubstrings": [
      "package.json",
      "tsconfig",
      "eslint.config",
      "pyproject.toml",
      "go.mod"
    ]
  }
}
